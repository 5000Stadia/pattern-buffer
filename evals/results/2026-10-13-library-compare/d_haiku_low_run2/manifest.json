      ],
      "personas": [],
      "role": null,
      "species": null,
      "type": "object"
    },
    {
      "anchor_quote": "I used to be called Pell Aven.",
      "fixture": false,
      "key": "person:pell_aven",
      "names": [
        "Pell Aven",
        "Pell"
      ],
      "personas": [],
      "role": null,
      "species": null,
      "type": "person"
    },
    {
      "anchor_quote": "You were the apprentice who stole the seventh tooth.",
      "fixture": false,
      "key": "object:seventh_tooth",
