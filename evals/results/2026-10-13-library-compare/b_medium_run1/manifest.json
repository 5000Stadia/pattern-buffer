      "key": "place:mouth_room",
      "names": [
        "Mouth Room"
      ],
      "personas": [],
      "role": null,
      "species": null,
      "type": "place"
    },
    {
      "anchor_quote": "\"Not a room,\" said Tovan Sere, listening with his left ear.",
      "fixture": false,
      "key": "person:tovan_sere",
      "names": [
        "Tovan Sere"
      ],
      "personas": [],
      "role": null,
      "species": null,
      "type": "person"
    },
    {
      "anchor_quote": "At her elbow sat a red key, a long iron thing with a forked tooth.",
